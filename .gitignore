# Root .gitignore for Autonomous Template Projects

# Operating System files
.DS_Store
Thumbs.db
*.swp
*~

# IDE and Editor configurations
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Build artifacts and caches
dist/
build/
out/
target/
*.log

# Node / JS / TS
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# Dart / Flutter
.dart_tool/
.packages

# Secrets and environment files
.env
.env.local
.env.*.local
*.pem
*.key
